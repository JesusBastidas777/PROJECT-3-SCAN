{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-scan:report:2.0",
  "type": "object",
  "required": ["schema_version", "document_type", "scan_id", "scanner", "started_at", "completed_at", "duration_ms", "target", "configuration", "capabilities", "summary", "assets", "observations", "errors"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "document_type": {"const": "scan_report"},
    "observations": {"type": "array"},
    "errors": {"type": "array"},
    "name_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "source", "status", "trusted"],
        "properties": {
          "source": {"const": "ptr"},
          "status": {"enum": ["resolved", "no_name", "timeout", "error", "skipped"]},
          "trusted": {"const": false}
        }
      }
    },
    "discovery_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["discovery_observation_id", "address", "ip_version", "method", "result"],
        "properties": {
          "method": {"enum": ["icmp_echo", "tcp_connect"]},
          "result": {"enum": ["response", "no_response", "timeout", "probe_error", "unsupported", "connected", "connection_refused", "unreachable", "error"]},
          "ip_version": {"enum": [4, 6]}
        }
      }
    }
  }
}
